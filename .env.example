# Claude Telegram Bot v2 - Environment Configuration

# ==============================================================================
# REQUIRED
# ==============================================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USERS=

# ==============================================================================
# RECOMMENDED
# ==============================================================================

# Working directory where Claude runs (loads CLAUDE.md, skills, MCP config)
CLAUDE_WORKING_DIR=

# Allowed paths for file operations (comma-separated)
ALLOWED_PATHS=

# ==============================================================================
# OPTIONAL - Voice Transcription
# ==============================================================================

# Path to Python executable (for Whisper voice transcription)
PYTHON_PATH=

# ==============================================================================
# OPTIONAL - Context Injection
# ==============================================================================

# Path to GRAFO injection script (auto-injects knowledge graph context)
GRAFO_INJECT_SCRIPT=

# ==============================================================================
# OPTIONAL - Extended Thinking
# ==============================================================================

# Keywords that trigger extended thinking (comma-separated, case-insensitive)
THINKING_KEYWORDS=think,pensa,ragiona

# Keywords that trigger deep thinking (50k tokens)
THINKING_DEEP_KEYWORDS=ultrathink,think hard,pensa bene

# ==============================================================================
# OPTIONAL - Advanced
# ==============================================================================

# Path to Claude CLI executable
CLAUDE_CODE_PATH=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Audit logging
AUDIT_LOG_PATH=/tmp/claude-telegram-audit.log
AUDIT_LOG_JSON=false
